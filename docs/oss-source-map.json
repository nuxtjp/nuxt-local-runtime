    "crates/rust-v8-local-runtime/tests/support/mod.rs",
    "scripts/consumer-security.check.mts",
    "security/project.mjs",
    "src/runtime/client/response.ts",
    "test/client.test.ts",
    "test/fixtures.ts",
    "test/schema.test.ts",
    "test/security.test.ts"
  ],
  "example_sources": [
    "crates/rust-v8-local-runtime/examples/local-ready.template.json",
    "crates/rust-v8-local-runtime/examples/local-simulation.json",
    "playground/app.vue",
