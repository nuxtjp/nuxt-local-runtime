{
  "repository": "nuxtjp/nuxt-local-runtime",
  "purpose": "利用者の明示操作で、ブラウザ画面から設定済みのローカルRust環境へ接続できます。 / Connect a browser interface to one explicitly configured local Rust runtime.",
  "responsibility_boundary": "Own the documented Nuxt/browser interface and its public contracts. Account authority, external effects, product state and production hosting remain explicit consumer responsibilities.",
  "packages": [
    {
      "manifest": "crates/rust-v8-local-runtime/Cargo.toml",
      "package": "nuxtjp-local-runtime-host",
      "ecosystem": "rust",
      "description": "Fail-closed loopback host and Rust/V8 adapter boundary for Nuxt",
      "interfaces": {
        "lib": "crates/rust-v8-local-runtime/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "config::{HostConfig, load_config}",
          "engine::{ContractSimulationEngine, ViewEngine}",
          "error::HostError",
          "host::LocalRuntimeHost",
          "http::run_server",
          "model::*",
          "payload::{PayloadField, PayloadScalarKind, PayloadSchema}",
          "process_engine::{\n    ProcessEngineConfig, ProcessView, ProcessViewEngine, WorkerLimits, WorkerPayload, worker_sha256,\n}",
          "security::{BoundaryTarget, InformationBand, SessionBudget, band_allows_target}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "package.json",
      "package": "@nuxtjp/local-runtime",
      "ecosystem": "npm",
      "description": "Fail-closed Nuxt client for a loopback local runtime",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./client": {
            "types": "./dist/runtime/client/index.d.ts",
            "import": "./dist/runtime/client/index.js"
          },
          "./guards": {
            "types": "./dist/runtime/shared/guards.d.ts",
            "import": "./dist/runtime/shared/guards.js"
          },
          "./types": {
            "types": "./src/runtime/shared/types.ts",
            "default": "./src/runtime/shared/types.ts"
          },
          "./schema": "./schemas/local-runtime-v1.schema.json"
        },
        "bin": {},
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build": "nuxt-module-build build && nuxt build playground",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run && pnpm run test:dependency-security && pnpm run test:consumer-security",
        "prepack": "pnpm run test && pnpm run typecheck && pnpm run build",
        "test:dependency-security": "node --test scripts/dependency-security.check.cjs",
        "test:consumer-security": "node --test scripts/consumer-security.check.mjs"
      }
    }
  ],
  "schema_definitions": [
    "crates/rust-v8-local-runtime/schemas/process-engine-v1.schema.json",
    "crates/rust-v8-local-runtime/schemas/process-view-v1.schema.json",
    "schemas/local-runtime-v1.schema.json"
  ],
