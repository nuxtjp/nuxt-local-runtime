    {
      "path": ".github/workflows/source-history.yml",
      "jobs": [
        {
          "job": "source-history",
          "condition": null,
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "condition": null
            },
            {
              "name": "Verify current owner provenance without restoring retired repositories",
              "run": "python3 - <<'PYCODE'\nimport json, os, re, subprocess\nfrom pathlib import Path, PurePosixPath\nrecord = Path('source-consolidation.json')\nassert record.is_file() and not record.is_symlink() and record.stat().st_size <= 65536\ndata = json.loads(record.read_text())\nassert data['owner_repository'] == os.environ['GITHUB_REPOSITORY']\nfor component in data.get('components', []):\n    assert component['owner_repository'] == data['owner_repository']\n    assert re.fullmatch(r'[0-9a-f]{40}', component['source_head'])\n    path = PurePosixPath(component['subpath'])\n    assert not path.is_absolute() and '..' not in path.parts\n    assert (Path('.') / path).is_dir()\n    assert not {'history_archive', 'history_ref', 'local_history_ref'} & component.keys()\nif not data.get('components'):\n    assert re.fullmatch(r'[0-9a-f]{40}', data['source_sha'])\nassert 'canonical_history_bundle' not in data\npaths = subprocess.check_output(['git', 'ls-files', '-z'], timeout=10).decode().split('\\0')\nassert len(paths) <= 8192\nassert not any(p.endswith('.bundle') or 'source-history' in PurePosixPath(p).parts for p in paths if p)\nprint('Current owner provenance verified; no historical repository restoration')\nPYCODE\n",
              "uses": null,
              "condition": null
            }
          ]
        }
      ]
